{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otcp.invalid/v1/schemas/vector.schema.json",
  "title": "OTCP test vector",
  "description": "Shape of the files in vectors/ (vectors/README.md). A vector is either a single request with its expected response or a multi-step scenario. Expected values may contain matchers.",
  "type": "object",
  "required": ["id", "type", "description", "capability", "since", "session"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "<directory>/<file name without .json>.",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9.]*/[a-z0-9][a-z0-9-]*$"
    },
    "type": { "enum": ["request", "scenario"] },
    "description": { "type": "string", "minLength": 1 },
    "capability": { "$ref": "common.schema.json#/$defs/capability" },
    "since": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "method": { "$ref": "common.schema.json#/$defs/methodName" },
    "session": {
      "description": "authenticated: the runner opens the main connection and completes session.hello with the discovery token before the vector starts. unauthenticated: the runner only opens the main connection.",
      "enum": ["authenticated", "unauthenticated"]
    },
    "given": { "$ref": "#/$defs/given" },
    "request": { "$ref": "#/$defs/value" },
    "paramsValid": {
      "description": "false when request.params deliberately violates the method's params schema. Default true.",
      "type": "boolean",
      "default": true
    },
    "response": { "$ref": "#/$defs/value" },
    "connectionAfter": { "enum": ["open", "closed"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "oneOf": [
    {
      "properties": { "type": { "const": "request" } },
      "required": ["method", "request", "response", "connectionAfter"],
      "not": { "required": ["steps"] }
    },
    {
      "properties": { "type": { "const": "scenario" } },
      "required": ["steps"],
      "allOf": [
        { "not": { "required": ["request"] } },
        { "not": { "required": ["response"] } },
        { "not": { "required": ["connectionAfter"] } }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)?$"
    },
    "given": {
      "description": "Preconditions the runner must establish before the vector starts. A runner that cannot establish them reports the vector as skipped with the reason.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bind", "kind", "state", "cancellable"],
            "additionalProperties": false,
            "properties": {
              "bind": { "$ref": "#/$defs/name" },
              "kind": { "$ref": "common.schema.json#/$defs/jobKind" },
              "state": { "$ref": "common.schema.json#/$defs/jobState" },
              "cancellable": { "type": "boolean" }
            }
          }
        },
        "withoutCapabilities": {
          "description": "Capabilities the instance does not report while the vector runs.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/capability",
            "not": { "const": "session.v1" }
          }
        }
      }
    },
    "matcher": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "$any": {
          "oneOf": [
            { "const": true },
            {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "object",
                "array",
                "null"
              ]
            }
          ]
        },
        "$approx": { "type": "number" },
        "$tol": { "type": "number", "minimum": 0 },
        "$capture": { "$ref": "#/$defs/name" },
        "$ref": { "$ref": "#/$defs/name" }
      },
      "oneOf": [
        {
          "required": ["$any"],
          "not": {
            "anyOf": [
              { "required": ["$approx"] },
              { "required": ["$tol"] },
              { "required": ["$ref"] }
            ]
          }
        },
        {
          "required": ["$approx"],
          "not": {
            "anyOf": [{ "required": ["$any"] }, { "required": ["$ref"] }]
          }
        },
        {
          "required": ["$capture"],
          "not": {
            "anyOf": [
              { "required": ["$any"] },
              { "required": ["$approx"] },
              { "required": ["$tol"] },
              { "required": ["$ref"] }
            ]
          }
        },
        { "required": ["$ref"], "maxProperties": 1 }
      ]
    },
    "plainObject": {
      "type": "object",
      "propertyNames": { "not": { "pattern": "^\\$" } },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "value": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "$ref": "#/$defs/plainObject" },
        { "$ref": "#/$defs/matcher" }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "connection": {
          "description": "Connection the step applies to. Default \"main\".",
          "$ref": "#/$defs/name"
        },
        "connect": { "$ref": "#/$defs/name" },
        "send": { "$ref": "#/$defs/value" },
        "sendRaw": { "type": "string" },
        "sendHex": {
          "description": "Bytes to send, as pairs of lowercase hexadecimal digits.",
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "sendFilled": {
          "description": "head, then fill repeated until head and fill together are exactly bytes long, then tail.",
          "type": "object",
          "required": ["head", "fill", "bytes", "tail"],
          "additionalProperties": false,
          "properties": {
            "head": { "type": "string" },
            "fill": { "type": "string", "pattern": "^[\\x20-\\x7E]$" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "tail": { "type": "string" }
          }
        },
        "expect": { "$ref": "#/$defs/value" },
        "expectClosed": {
          "type": "object",
          "required": ["noBytes"],
          "additionalProperties": false,
          "properties": {
            "noBytes": { "type": "boolean" },
            "withinMs": { "type": "integer", "minimum": 1, "maximum": 60000 }
          }
        },
        "pauseMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["connect"] },
        { "required": ["send"] },
        { "required": ["sendRaw"] },
        { "required": ["sendHex"] },
        { "required": ["sendFilled"] },
        { "required": ["expect"] },
        { "required": ["expectClosed"] },
        { "required": ["pauseMs"] }
      ]
    }
  }
}
