{
  "$schema": "../../schemas/vector.schema.json",
  "id": "session/hello-auth-failed-malformed",
  "type": "request",
  "description": "A hello whose params do not validate (the token is not hex and client is missing) gets the same fixed AUTH_FAILED response as a wrong token, and the server closes the connection.",
  "capability": "session.v1",
  "since": "1.0",
  "method": "session.hello",
  "session": "unauthenticated",
  "request": {
    "jsonrpc": "2.0",
    "id": "h1",
    "method": "session.hello",
    "params": { "token": "not-a-token", "protocol": "1.0" }
  },
  "paramsValid": false,
  "response": {
    "jsonrpc": "2.0",
    "id": "h1",
    "error": {
      "code": -32001,
      "message": "AUTH_FAILED",
      "data": {
        "kind": "AUTH_FAILED",
        "retryable": false,
        "detail": "authentication failed",
        "executed": false
      }
    }
  },
  "connectionAfter": "closed"
}
