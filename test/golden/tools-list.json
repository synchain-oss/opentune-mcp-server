                            "enum": [
                              "major",
                              "minor",
                              "chromatic",
                              "harmonicMinor",
                              "dorian",
                              "mixolydian",
                              "pentatonicMajor",
                              "pentatonicMinor"
                            ]
                          }
                        },
                        "required": [
                          "root",
                          "scale"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "op",
                  "select",
                  "scale"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "setParams"
                  },
                  "select": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "indices": {
                            "minItems": 1,
                            "maxItems": 1000,
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          }
                        },
