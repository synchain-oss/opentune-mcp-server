                          },
                          "to_sec": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "from_sec",
                          "to_sec"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "all": {
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "required": [
                          "all"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "off_target_cents_over": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1200
                          },
                          "from_sec": {
                            "type": "number",
                            "minimum": 0
                          },
                          "to_sec": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "off_target_cents_over"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "retune_speed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "vibrato_depth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "vibrato_rate_hz": {
                    "type": "number",
                    "minimum": 3,
                    "maximum": 12
                  },
                  "pitch_drift_scale": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 3
                  }
                },
                "required": [
                  "op",
                  "select"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": "Each op has select. select = {indices:[...]} (from opentune_get_notes), {from_sec,to_sec} (source-audio seconds, overlapping), {all:true}, or {off_target_cents_over:N, from_sec?, to_sec?} (voiced notes whose sung pitch is more than N cents from their target). Every condition is evaluated on the notes at expected_revision, before any op runs, so an earlier op does not change what a later condition selects."
        },
        "dry_run": {
          "description": "Predict the changes without applying them.",
          "type": "boolean"
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
