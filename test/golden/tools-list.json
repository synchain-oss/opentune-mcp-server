  {
    "name": "opentune_undo",
    "title": "Undo the top OpenTune step",
    "description": "OpenTune (audio vocal pitch editor): undoes the step on top of the undo history, but only if it is the step undo_id names; otherwise UNDO_CONFLICT, and then ask the user (the history has changed). Only edits that reported an undo id can be undone. A step that changes nothing still uses up the undo step and marks the project changed (UNDO_NO_EFFECT). Clip split, merge and delete cannot be undone safely in some builds (undo_unsafe_build). The result gives the opentune_redo call that takes this back.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "undo_id": {
          "type": "string",
          "pattern": "^u:[0-9a-f]{8}:[1-9][0-9]*$",
          "description": "The undo id (u:...) of the step you expect on top, from the write result that made it."
        },
        "force": {
          "description": "Only when the user explicitly asked to undo or redo a change that was not made through this server: applies the top step whatever it is. Never set it to get past UNDO_CONFLICT on your own.",
          "type": "boolean"
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "undo_id"
      ],
      "additionalProperties": false
    },
