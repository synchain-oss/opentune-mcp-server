[
  {
    "name": "opentune_get_status",
    "title": "Get OpenTune status",
    "description": "OpenTune (audio vocal pitch editor): reports whether this server can use OpenTune now, as one state (READY, NOT_READY, PROTOCOL_MISMATCH, STARTING, RUNNING_WITHOUT_API, NOT_RUNNING, NO_API_BUILD, NOT_INSTALLED, WSL_UNSUPPORTED_RUNTIME) with a nextStep saying who should do what. Call it first, and again whenever a tool error says so. Lists the running instances with their instance_id; when several run, ask the user which one to use. Read-only: it never starts, stops or changes OpenTune.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "instance_id": {
          "description": "Report only this instance (32 hex digits, from an earlier result). Omit to report all.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "anthropic/alwaysLoad": true
    }
  },
  {
    "name": "opentune_get_project",
    "title": "Get OpenTune project",
    "description": "OpenTune (audio vocal pitch editor): reads the open project: path and unsaved-changes flag, tracks (volume, mute, solo), clips with timeline start, end and source file, a summary of each clip content (analysis state, key, note count, pitch shift), the selection and the transport. Every clip carries a clip_revision and the result an arrangement_revision: pass them as expected_revision to write tools. track_ids limits the result to those tracks; include_history adds the undo and redo tops. Read-only.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "track_ids": {
          "description": "Only these tracks and their clips (0-based track ids; positions, they shift when a track is deleted).",
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "include_history": {
          "description": "Also return the tops of the undo and redo histories. Default false.",
          "type": "boolean"
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "opentune_get_notes",
    "title": "Get OpenTune notes",
    "description": "OpenTune (audio vocal pitch editor): lists the notes of one clip in start-time order, a page at a time (limit default 100, at most 200; fewer when the page would be large). Each note has its index, start and end seconds on the content clock (source audio) and, for a clip placement, on the timeline clock, detected and target MIDI pitch, offset in cents, retune speed (0 natural to 1 mechanical), vibrato and voiced / corrected flags. clock says which clock from and to use; timeline needs a placement id. Read-only.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clip": {
          "type": "string",
          "pattern": "^[pc]:[0-9a-f]{8}:(0|[1-9][0-9]*):(0|[1-9][0-9]*)$",
          "description": "Clip placement id (p:...) from opentune_get_project, or a content id (c:...)."
        },
        "clock": {
          "type": "string",
          "enum": [
            "content",
            "timeline"
          ],
          "description": "Clock of from and to: content = seconds of the source audio, timeline = seconds of the arrangement (placement ids only). Required."
        },
        "from": {
          "description": "Range start in seconds on the given clock. Give both from and to.",
          "type": "number",
          "minimum": 0
        },
        "to": {
          "description": "Range end in seconds on the given clock. Notes overlapping the range.",
          "type": "number",
          "minimum": 0
        },
        "cursor": {
          "description": "next_cursor of the previous page, passed back unchanged.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "limit": {
          "description": "Notes per page, 1 to 200. Default 100.",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "clip",
        "clock"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "opentune_get_job",
    "title": "Get OpenTune job",
    "description": "OpenTune (audio vocal pitch editor): reports a long-running job (import, export, analysis, project open or save): state queued, running, succeeded, failed or cancelled, progress, and when it has ended its result or error. With wait_seconds it waits up to that long for the job to end. Finished jobs are kept for 30 minutes. Read-only.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^j:[0-9a-f]{8}:[1-9][0-9]*$",
          "description": "Job id from the result that started the job (j:...)."
        },
        "wait_seconds": {
          "description": "Seconds to wait for the job to end before answering, 0 to 30. Default 0: answer at once.",
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "instance_id": {
          "description": "Instance that owns the job. Optional: the job id identifies it.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "opentune_cancel_job",
    "title": "Cancel OpenTune job",
    "description": "OpenTune (audio vocal pitch editor): asks OpenTune to stop a running job and reports the outcome. Work the job already committed stays: an import keeps the items imported so far, and the result lists them with how to revert each; an export never touches the target file. Project saves, preference changes and project opens past their preparation cannot be cancelled; the error then says so and the job continues.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^j:[0-9a-f]{8}:[1-9][0-9]*$",
          "description": "Job id from the result that started the job (j:...)."
        },
        "instance_id": {
          "description": "Instance that owns the job. Optional: the job id identifies it.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "opentune_launch",
    "title": "Start OpenTune",
    "description": "OpenTune (audio vocal pitch editor): starts the OpenTune build configured for this server (OPENTUNE_MCP_OPENTUNE_PATH) with its control API and waits up to 30 seconds until it is ready, then reports the state like opentune_get_status, with a nextStep. Starts nothing when OpenTune already runs (alreadyRunning), may run without the control API, or no API build is configured; the result says why. Repeated or concurrent calls share one start. allow_second_instance needs the user's explicit consent; each call with it starts one more instance once earlier starts are done. Never closes OpenTune.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allow_second_instance": {
          "description": "Start OpenTune even though an instance with the control API runs, or even though this server cannot list the running processes to rule out an OpenTune without the control API. Only when the user explicitly asked for a second instance, or confirmed that no OpenTune runs. Default false: start nothing then.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "opentune_set_clip",
    "title": "Set OpenTune clip key and pitch shift",
    "description": "OpenTune (audio vocal pitch editor): sets the key (root and scale) and/or the pitch shift (whole semitones plus cents) of a clip. The key change cannot be undone (as in OpenTune); the result gives the opentune_set_clip call that restores the previous key. The pitch shift is one undo step; it does not transpose the key. With both, two requests run, key first, and the result reports each. Needs the clip_revision as expected_revision; only the key part of it is checked. The result returns the new clip_revision. Setting the current value changes nothing.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clip": {
          "type": "string",
          "pattern": "^[pc]:[0-9a-f]{8}:(0|[1-9][0-9]*):(0|[1-9][0-9]*)$",
          "description": "Clip placement id (p:...) from opentune_get_project, or a content id (c:...)."
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The clip_revision of the clip from opentune_get_project, opentune_get_notes or the last write result for it, passed back unchanged."
        },
        "key": {
          "description": "The clip key to set. Not undoable; the result gives the way back.",
          "type": "object",
          "properties": {
            "root": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "Tonic pitch class: 0 = C, 1 = C sharp ... 11 = B."
            },
            "scale": {
              "type": "string",
              "enum": [
                "major",
                "minor",
                "chromatic",
                "harmonicMinor",
                "dorian",
                "mixolydian",
                "pentatonicMajor",
                "pentatonicMinor"
              ]
            }
          },
          "required": [
            "root",
            "scale"
          ],
          "additionalProperties": false
        },
        "pitch_shift": {
          "description": "Pitch shift to set: whole semitones -24..24 plus cents -99..99. Undoable.",
          "type": "object",
          "properties": {
            "semitones": {
              "type": "integer",
              "minimum": -24,
              "maximum": 24
            },
            "cents": {
              "type": "integer",
              "minimum": -99,
              "maximum": 99
            }
          },
          "required": [
            "semitones",
            "cents"
          ],
          "additionalProperties": false
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "clip",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "summary": {},
        "applied": {},
        "noOp": {},
        "dryRun": {},
        "changes": {},
        "created": {},
        "removed": {},
        "idMap": {},
        "revisionDiff": {},
        "tokens": {},
        "undo": {},
        "dirty": {},
        "ui": {},
        "sideEffects": {},
        "warnings": {},
        "job": {},
        "uiEffects": {},
        "changeTable": {},
        "lines": {}
      },
      "additionalProperties": {}
    }
  },
  {
    "name": "opentune_autotune_range",
    "title": "Auto-tune a range of an OpenTune clip",
    "description": "OpenTune (audio vocal pitch editor): runs AUTO on a clip with an explicit mode. regenerate rebuilds notes in ranges from the sung pitch, snapped to scale; snapNotes moves existing note targets to scale; notesOnly replaces ALL notes, cannot be undone, needs replace_edited_notes true; reference aligns to the reference clip (needs reference.v1). Ranges: source-audio seconds, default whole clip, max 16, one undo step. Unset parameters use generator defaults, not window knobs. retune_speed 0..1: 0 keeps natural movement, 1 sounds mechanical.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clip": {
          "type": "string",
          "pattern": "^[pc]:[0-9a-f]{8}:(0|[1-9][0-9]*):(0|[1-9][0-9]*)$",
          "description": "Clip placement id (p:...) from opentune_get_project, or a content id (c:...)."
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The clip_revision of the clip from opentune_get_project, opentune_get_notes or the last write result for it, passed back unchanged."
        },
        "mode": {
          "type": "string",
          "enum": [
            "regenerate",
            "snapNotes",
            "notesOnly",
            "reference"
          ]
        },
        "ranges": {
          "description": "Source-audio seconds. Default: whole clip.",
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_sec": {
                "type": "number",
                "minimum": 0
              },
              "to_sec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "from_sec",
              "to_sec"
            ],
            "additionalProperties": false
          }
        },
        "exclude": {
          "description": "Source-audio seconds left untouched.",
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_sec": {
                "type": "number",
                "minimum": 0
              },
              "to_sec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "from_sec",
              "to_sec"
            ],
            "additionalProperties": false
          }
        },
        "scale": {
          "description": "Key to snap to, or \"clip\" for the clip key. Needed by regenerate and snapNotes.",
          "anyOf": [
            {
              "type": "string",
              "const": "clip"
            },
            {
              "type": "object",
              "properties": {
                "root": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11,
                  "description": "Tonic pitch class: 0 = C, 1 = C sharp ... 11 = B."
                },
                "scale": {
                  "type": "string",
                  "enum": [
                    "major",
                    "minor",
                    "chromatic",
                    "harmonicMinor",
                    "dorian",
                    "mixolydian",
                    "pentatonicMajor",
                    "pentatonicMinor"
                  ]
                }
              },
              "required": [
                "root",
                "scale"
              ],
              "additionalProperties": false
            }
          ]
        },
        "retune_speed": {
          "description": "0 keeps natural pitch movement, 1 is mechanical.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vibrato_depth": {
          "description": "Added vibrato; 100 is plus or minus a semitone.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "vibrato_rate_hz": {
          "type": "number",
          "minimum": 3,
          "maximum": 12
        },
        "note_split_cents": {
          "description": "Note-split sensitivity.",
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "dry_run": {
          "description": "Predict the changes without applying them.",
          "type": "boolean"
        },
        "replace_edited_notes": {
          "description": "Only with the explicit consent of the user: lets notesOnly replace all notes, irreversibly.",
          "type": "boolean"
        },
        "instance_id": {
          "description": "OpenTune instance (32 hex digits, from opentune_get_status). Optional when one instance runs.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "clip",
        "expected_revision",
        "mode"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "summary": {},
        "applied": {},
        "noOp": {},
        "dryRun": {},
        "changes": {},
        "created": {},
        "removed": {},
        "idMap": {},
        "revisionDiff": {},
        "tokens": {},
        "undo": {},
        "dirty": {},
        "ui": {},
        "sideEffects": {},
        "warnings": {},
        "job": {},
        "uiEffects": {},
        "changeTable": {},
        "lines": {}
      },
      "additionalProperties": {}
    }
  },
  {
    "name": "opentune_edit_notes",
    "title": "Edit OpenTune notes",
    "description": "OpenTune (audio vocal pitch editor): edits existing notes of a clip as the piano roll does; never adds or removes notes. ops (1-32, in order, one undo step): setTargetPitch, shiftCents, snapToScale, setParams (retune_speed 0..1: 0 keeps the natural pitch movement, 1 sounds mechanical; vibrato; pitch_drift_scale). Each op selects notes; selections refer to the notes at expected_revision. dry_run previews.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clip": {
          "type": "string",
