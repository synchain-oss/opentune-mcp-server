# 依赖与构建产物
node_modules/
dist/
coverage/
*.tsbuildinfo

# 本地缓存:按 sha256 校验后下载的工具(scripts/fetch-tool.mjs)、esbuild metafile、gates 的临时报告
.cache/

# 打包产物(npm pack 的 tarball、MCPB 包):只作为 CI 产物与 Release 附件分发,不入库
*.tgz
*.mcpb

# skill 自带的 Python 测试(CI 的 plugin job 在 skill 目录里跑 pytest)留下的缓存;插件组装同样跳过它们
__pycache__/
.pytest_cache/
*.pyc

# 本地环境与日志
.env
.env.local
npm-debug.log*

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
